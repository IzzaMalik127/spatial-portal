# Optional. Free token from https://ion.cesium.com -> unlocks World Terrain (DEM) and OSM 3D Buildings.
VITE_CESIUM_ION_TOKEN=
# Optional. Base URL of your REST backend. Defaults to the sample data in /public/data
VITE_API_BASE_URL=/data
# Optional. Free token from https://account.mapbox.com -> enables the 2D Mapbox overview mini-map.
VITE_MAPBOX_TOKEN=
